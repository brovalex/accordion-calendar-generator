    "paperSizes": {
        "roll": {
            "width": 8.75,
            "height": null
        },
        "strip": {
            "width": 7,
            "height": 42
        },
        "letter": {
            "width": 11,
            "height": 8.5
        },
        "maxroll": {
            "width": 12.5,
            "height": null
        }
    },
    "fonts": {
        "textFont": {
            "file": "fonts/Roboto-Bold.ttf"
        },
        "monthFont": {
            "file": "fonts/Roboto-Bold.ttf",
            "yShift": -5
        },
        "digitsFont": {
            "file": "fonts/RobotoMono-Regular.ttf"
        },
        "weeksFont": {
            "file": "fonts/Roboto-Regular.ttf"
        }
    },
    "presets": {
        "classic": {
            "layout": "grid",
            "flow": "vertical",
            "grain": "week"
        },
        "planner": {
            "layout": "planner",
            "flow": "horizontal",
            "grain": "day",
            "pagination": {
                "mode": "monthly",
                "pagesPerMonth": 2,
                "daysPerPage": 14
            },
            "weekend": {
                "shade": true
            },
            "weekDivider": true,
            "columnLines": true,
            "bands": {
                "count": 12,
                "stripes": false,
                "hairlines": false,
                "hours": {
                    "labels": "none",
                    "first": 0,
                    "perBand": 2
                }
            },
            "labels": {
                "month": "auto",
                "weekday": "short",
                "weekdayBottom": false,
                "weekNumbers": false,
                "digitsTop": true,
                "digitsBottom": true
            },
            "padding": {
                "x": 0.2,
                "top": 0.2,
                "bottom": 0.2
            }
        },
        "planner-across": {
            "extends": "planner",
            "arrange": "across",
            "flush": true
        },
        "planner-yearly": {
            "extends": "planner-across",
            "clearMonthHeader": true,
            "labels": {
                "weekNumberBottom": true,
                "digitsBottomColor": "gray"
            },
            "weekend": {
                "shade": false
            },
            "bands": {
                "stripes": true
            }
        },
        "planner-project": {
            "extends": "planner-across",
            "clearMonthHeader": true,
            "pagination": {
                "mode": "fixed",
                "daysPerPage": 14,
                "startAt": "week1"
            },
            "labels": {
                "year": true,
                "quarter": "weeks",
                "cycles": {
                    "weeks": 6,
                    "cooldown": 2
                },
                "month": "vertical",
                "weekdayTop": true,
                "weekdayBottom": true,
                "digitsTop": true,
                "monthWatermark": true
            },
            "fontSizes": {
                "monthVertical": 5,
                "year": 6,
                "quarter": 12,
                "cycle": 6
            },
            "padding": {
                "top": 0.1
            }
        },
        "planner-weekly": {
            "extends": "planner-across",
            "pagination": {
                "mode": "fixed",
                "daysPerPage": 7,
                "startAt": "week1"
            },
            "weekend": {
                "shade": true,
                "overStripes": true
            },
            "bands": {
                "count": 16,
                "stripes": true,
                "invert": true,
                "hours": {
                    "labels": "inside",
                    "first": 6,
                    "perBand": 1,
                    "pad": true,
                    "color": "lightgray"
                }
            },
            "labels": {
                "month": "none",
                "monthWatermark": true,
                "monthWatermarkScale": 1.05,
                "monthWatermarkOffset": 8,
                "dayHeader": "inline",
                "moon": {},
                "weekNumberBottomLeft": true,
                "weekNumberPrefix": "Week ",
                "digitsBottom": false
            },
            "fontSizes": {
                "days": 11,
                "weekday": 6
            }
        },
        "planner-fixed": {
            "extends": "planner",
            "pagination": {
                "mode": "fixed",
                "daysPerPage": 14
            }
        },
        "planner-hours": {
            "extends": "planner-fixed",
            "weekend": {
                "shade": false
            },
            "bands": {
                "stripes": true,
                "hairlines": false,
                "hours": {
                    "labels": "both"
                }
            }
        },
        "planner-month": {
            "extends": "planner",
            "pagination": {
                "pagesPerMonth": 1
            },
            "labels": {
                "weekday": "letter"
            },
            "fontSizes": {
                "days": 6.5,
                "weekday": 5,
                "weekNumber": 4.5
            }
        }
    }
}
